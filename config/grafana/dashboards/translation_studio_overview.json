      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(translation_requests_total[1m])) by (provider, status)", "legendFormat": "{{provider}} / {{status}}", "refId": "A"}]
