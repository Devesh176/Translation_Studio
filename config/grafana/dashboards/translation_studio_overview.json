      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(translation_provider_failures_total[5m])) by (provider, failure_code)", "legendFormat": "{{provider}} / {{failure_code}}", "refId": "A"}]
