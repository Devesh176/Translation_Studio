      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(layout_overflow_total[5m])", "legendFormat": "overflow", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(layout_overlap_total[5m])", "legendFormat": "overlap", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(font_missing_glyph_total[5m])) by (script)", "legendFormat": "missing glyph {{script}}", "refId": "C"}
      ]
