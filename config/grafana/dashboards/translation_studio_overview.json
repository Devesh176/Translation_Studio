      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(render_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "A"}]
    },
