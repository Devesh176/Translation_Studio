      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "((rate(translation_cache_hits_total[5m])) / ((rate(translation_cache_hits_total[5m]) + rate(translation_cache_misses_total[5m])) > 0)) or vector(0)", "legendFormat": "hit rate", "refId": "A"}]
