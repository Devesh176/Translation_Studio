        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(pipeline_duration_seconds_bucket[10m])) by (le, status))", "legendFormat": "p95 {{status}}", "refId": "B"}
